<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_item_focus"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/tvChannelNum"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:textColor="@color/tv_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:text="01" />

    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="38dp"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/tv_text_primary"
        android:textSize="18sp"
        android:text="CCTV-1 综合" />

    <TextView
        android:id="@+id/tvSourceCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="@color/tv_text_secondary"
        android:textSize="12sp"
        android:text="3线" />
</LinearLayout>
